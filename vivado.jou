synth_design \
      -top soc_top \
      -part $part_name \
      -flatten_hierarchy rebuilt
  report_utilization \
      -file "$project_root/post_synth_utilization.rpt"
  report_timing_summary \
      -delay_type max \
      -max_paths 20 \
      -file "$project_root/post_synth_timing_summary.rpt"
  write_checkpoint -force "$project_root/post_synth.dcp"
set project_root "/home/trungpham/PROJECT/KLTN"
  set part_name "xc7a100tcsg324-1"
  set_part $part_name
  set fh [open "$project_root/filelist_soc.f" r]
  while {[gets $fh source_file] >= 0} {
      set source_file [string trim $source_file]

      if {$source_file eq "" || [string match "#*" $source_file]} {
          continue
      }

      read_verilog -sv "$project_root/$source_file"
  }
  close $fh
  read_xdc "$project_root/timing.xdc"
  synth_design \
      -top soc_top \
      -part $part_name \
      -flatten_hierarchy rebuilt
